<Project>
  <!-- Shared settings for all projects in app/ -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>1.1.1</Version>
    <!-- UI texts: Resources/Strings.resx = English (neutral), Strings.de.resx = German (R1) -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Only German satellites besides the English neutral resources (also for framework packages: smaller portable exe) -->
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <!-- Publisher is the author (a person); "ueniverse" is never a company name -->
    <Company>Dominik Poschinger</Company>
    <Authors>Dominik Poschinger</Authors>
    <Copyright>Copyright (C) 2026 Dominik Poschinger</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Product>ue Bar</Product>
  </PropertyGroup>
</Project>
