<Window x:Class="UeBar.App.Bar.BarWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UeBar.App.Bar.Views"
        xmlns:media="clr-namespace:UeBar.App.Bar.Media"
        xmlns:vm="clr-namespace:UeBar.App.Bar.ViewModels"
        Title="ue Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource BarFont}"
        Foreground="{StaticResource TextBrush}"
        Width="10" Height="10">
    <Grid x:Name="Root">
        <!-- Shell = the visible area; morphs from the pill to the panel -->
        <Border x:Name="Shell" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </Border.RenderTransform>
            <Grid>
                <Grid x:Name="PillLayer" Height="40" Margin="18,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <!-- Default: first status value -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PillContent}" Value="{x:Static vm:PillContent.Status}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource IconText}" FontSize="15" Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding PillStatus.Icon, Converter={StaticResource IconGlyph}, FallbackValue=&#xE99A;}" />
                        <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="260"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding PillStatus.Text, FallbackValue=ue Bar, TargetNullValue=ue Bar}" />
                    </StackPanel>

                    <!-- Now Playing: cover + title + playing/paused (no per-second ticking) -->
                    <StackPanel Orientation="Horizontal" Margin="-10,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PillContent}" Value="{x:Static vm:PillContent.NowPlaying}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource TileOffBrush}" ClipToBounds="True" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xEC4F;" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                                <media:CoverImage ImageId="{Binding NowPlaying.ImageId}" ModuleId="{Binding NowPlaying.ModuleId}">
                                    <media:CoverImage.Clip>
                                        <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" />
                                    </media:CoverImage.Clip>
                                </media:CoverImage>
                            </Grid>
                        </Border>
                        <TextBlock Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="240"
                                   TextTrimming="CharacterEllipsis" Text="{Binding NowPlaying.Title}" />
                        <TextBlock Style="{StaticResource IconText}" FontSize="13" Margin="10,0,0,0" Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding NowPlaying.PlayPauseGlyph}" />
                    </StackPanel>

                    <!-- Notification: icon + title + text -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PillContent}" Value="{x:Static vm:PillContent.Notification}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource IconText}" FontSize="15" Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding Notification.Icon, Converter={StaticResource IconGlyph}}" />
                        <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="200"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Notification.Title}" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" MaxWidth="300" Opacity="0.85"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Notification.Message}"
                                   Visibility="{Binding Notification.HasMessage, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </Grid>
                <views:PanelView x:Name="PanelLayer" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <!-- OLED protection (M7): dim = cover with black (not make transparent) -->
                <Border x:Name="DimOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
