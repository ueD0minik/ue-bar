<UserControl x:Class="UeBar.App.Bar.Views.SliderElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UeBar.App.Bar.Views"
             Margin="0,6,0,0">
    <Grid IsEnabled="{Binding IsEnabled}">
        <Slider x:Name="Slider"
                Style="{StaticResource OneUiSlider}"
                Foreground="{Binding DataContext.FillBrush, RelativeSource={RelativeSource AncestorType=views:TileView}, FallbackValue={StaticResource AccentBrush}}"
                Minimum="{Binding Min}"
                Maximum="{Binding Max}"
                SmallChange="{Binding Step}"
                Value="{Binding Value, Mode=OneWay}" />
        <TextBlock Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12">
            <Run Text="{Binding Label, Mode=OneWay}" />
            <Run Text="{Binding Value, ElementName=Slider, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text="{Binding Unit, Mode=OneWay}" />
        </TextBlock>
    </Grid>
</UserControl>
