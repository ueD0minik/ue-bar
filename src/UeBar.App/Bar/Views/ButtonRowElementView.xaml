<UserControl x:Class="UeBar.App.Bar.Views.ButtonRowElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UeBar.App.Bar.Views"
             x:Name="Root"
             Margin="0,6,0,0">
    <ItemsControl ItemsSource="{Binding Buttons, Converter={StaticResource UiMirror}}" IsEnabled="{Binding IsEnabled}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Margin="2,0" Height="32" Padding="0" Click="OnClick" ToolTip="{Binding Label}" IsEnabled="{Binding IsEnabled}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="{Binding DataContext.FillBrush, RelativeSource={RelativeSource AncestorType=views:TileView}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="{Binding Icon, Converter={StaticResource IconGlyph}}" />
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
