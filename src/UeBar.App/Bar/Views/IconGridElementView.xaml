<UserControl x:Class="UeBar.App.Bar.Views.IconGridElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="clr-namespace:UeBar.App.Bar.Media"
             Margin="0,6,0,0">
    <!-- P2-4: icons with names (e.g. several shortcuts in one tile). Tap = Press with the entry's ID. -->
    <ItemsControl ItemsSource="{Binding Items, Converter={StaticResource UiMirror}}" IsEnabled="{Binding IsEnabled}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Margin="2" Height="58" Padding="2,4" Click="OnClick" IsEnabled="{Binding IsEnabled}"
                        Style="{StaticResource BarButton}" ToolTip="{Binding StateText}">
                    <StackPanel>
                        <Grid Width="26" Height="26" HorizontalAlignment="Center">
                            <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"
                                       Text="{Binding Icon, Converter={StaticResource IconGlyph}}" />
                            <media:CoverImage x:Name="Picture" ImageId="{Binding ImageUrl}" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Picture" Property="Source" Value="{x:Null}">
                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
