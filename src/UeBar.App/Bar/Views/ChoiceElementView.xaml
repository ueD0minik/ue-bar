<UserControl x:Class="UeBar.App.Bar.Views.ChoiceElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UeBar.App.Bar.Views"
             x:Name="Root"
             Margin="0,6,0,0">
    <StackPanel IsEnabled="{Binding IsEnabled}">
        <TextBlock Style="{StaticResource SubText}" Text="{Binding Label}" Margin="2,0,0,4"
                   Visibility="{Binding Label, Converter={StaticResource NullToCollapsed}}" />
        <ItemsControl ItemsSource="{Binding Options, Converter={StaticResource UiMirror}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="1.5,0" Height="28" Padding="1,0" Click="OnClick" ToolTip="{Binding Label}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource EqualsMulti}">
                                                <Binding Path="Id" />
                                                <Binding Path="DataContext.SelectedId" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="{Binding DataContext.FillBrush, RelativeSource={RelativeSource AncestorType=views:TileView}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding Label}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
