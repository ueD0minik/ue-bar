<UserControl x:Class="UeBar.App.Bar.Views.StepperElementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UeBar.App.Localization"
             Margin="0,6,0,0">
    <Grid IsEnabled="{Binding IsEnabled}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource BarButton}" Width="36" Height="32" Padding="0" Click="OnMinus" ToolTip="{l:T Element_Less}">
            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE738;" />
        </Button>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold">
                <Run>
                    <Run.Text>
                        <MultiBinding Converter="{StaticResource NumberMulti}" Mode="OneWay">
                            <Binding Path="Value" />
                            <Binding Path="Decimals" />
                        </MultiBinding>
                    </Run.Text>
                </Run><Run Text="{Binding Unit, Mode=OneWay}" FontSize="12" />
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubText}" Text="{Binding Label}"
                       Visibility="{Binding Label, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource BarButton}" Width="36" Height="32" Padding="0" Click="OnPlus" ToolTip="{l:T Element_More}">
            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE710;" />
        </Button>
    </Grid>
</UserControl>
