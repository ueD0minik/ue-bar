<UserControl x:Class="UeBar.App.Bar.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UeBar.App.Bar.Views"
             xmlns:media="clr-namespace:UeBar.App.Bar.Media"
             xmlns:l="clr-namespace:UeBar.App.Localization">
    <UserControl.Resources>
        <!-- Button row with icon + text (tabs, targets, types) -->
        <DataTemplate x:Key="IconOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0"
                           Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                           Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <StackPanel Margin="16,0,16,16">
        <!-- Grip bar: for moving in the pinned state -->
        <Border x:Name="Grip" Height="18" Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                            <Setter Property="Cursor" Value="SizeAll" />
                            <Setter Property="ToolTip" Value="{l:T Panel_DragToMove}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="36" Height="4" CornerRadius="2" Background="{StaticResource GripBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Header normal: status line + module dots + edit + pin -->
        <Grid Height="32" Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding StatusItems}" VerticalAlignment="Center" ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="{Binding Tooltip}">
                            <TextBlock Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource SubTextBrush}"
                                       Text="{Binding Icon, Converter={StaticResource IconGlyph}}" />
                            <TextBlock Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" Text="{Binding Text}" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding ModuleDots}" VerticalAlignment="Center" Margin="8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" Padding="3" ToolTip="{Binding Tooltip}">
                            <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bell: notification history (M6) -->
            <Button Grid.Column="2" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Command="{Binding ToggleHistoryCommand}" ToolTip="{l:T Panel_Notifications}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                        <Setter Property="Background" Value="{StaticResource TabInactiveBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowHistory}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xEA8F;" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0"
                             Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>

            <Button Grid.Column="3" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Command="{Binding EditCommand}"
                    Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}" ToolTip="{l:T Panel_Edit}"
                    Visibility="{Binding ShowTabs, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE70F;" />
            </Button>

            <!-- Gear (M7): settings -->
            <Button Grid.Column="4" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}" ToolTip="{l:T Panel_Settings}">
                <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE713;" />
            </Button>

            <Button Grid.Column="5" Width="32" Height="32" Padding="0" Command="{Binding TogglePinCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                        <Setter Property="Background" Value="{StaticResource TabInactiveBrush}" />
                        <Setter Property="ToolTip" Value="{l:T Panel_Pin}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="ToolTip" Value="{l:T Panel_Unpin}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE718;" />
            </Button>
        </Grid>

        <!-- Header in edit mode -->
        <Grid Height="32" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE70F;" Margin="2,0,8,0" />
                <TextBlock Text="{l:T Panel_Edit}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Width="32" Height="32" Padding="0" Margin="0,0,6,0" Style="{StaticResource BarButton}"
                    Command="{Binding Edit.UndoCommand}" ToolTip="{l:T Panel_Undo}">
                <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE7A7;" />
            </Button>
            <Button Grid.Column="2" Height="32" Padding="14,0" Margin="0,0,6,0" Style="{StaticResource BarButton}"
                    Command="{Binding Edit.CancelCommand}" Content="{l:T Common_Cancel}" ToolTip="{l:T Panel_CancelEdit_Tip}" />
            <Button Grid.Column="3" Height="32" Padding="14,0" Style="{StaticResource BarButton}" Background="{DynamicResource AccentBrush}"
                    Command="{Binding Edit.DoneCommand}" Content="{l:T Common_Done}" ToolTip="{l:T Common_Save}" />
        </Grid>

        <!-- Body: in edit mode everything below the header scrolls (otherwise only the grid) -->
        <ScrollViewer x:Name="BodyScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
        <!-- Quick search (M6): the global hotkey opens the panel with this field -->
        <StackPanel Margin="0,8,0,4" DataContext="{Binding QuickSearch}"
                    Visibility="{Binding DataContext.IsQuickSearchOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <TextBox x:Name="QuickSearchBox" Style="{StaticResource EditTextBox}" Padding="16,6,6,6"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnQuickSearchKeyDown" />
                <TextBlock Style="{StaticResource IconText}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="&#xE721;" />
            </Grid>
            <TextBlock Style="{StaticResource SubText}" Margin="4,6,0,0" FontSize="11" Text="{Binding Hint}"
                       Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl ItemsSource="{Binding Results}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="350">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="{Binding Icon, Converter={StaticResource IconGlyph}}" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource SubText}" FontSize="10" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource SubText}" Margin="4,2,0,4" FontSize="10" Text="{l:T Search_Keys}" />
        </StackPanel>

        <!-- Notification with the panel open (M6) -->
        <Border CornerRadius="18" Background="{StaticResource TileOffBrush}" Padding="12,8" Margin="0,8,0,0"
                Visibility="{Binding HasNotification, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,10,0"
                           Text="{Binding Notification.Icon, Converter={StaticResource IconGlyph}}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Notification.Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SubText}" FontSize="12" Text="{Binding Notification.Message}" TextWrapping="Wrap"
                               Visibility="{Binding Notification.HasMessage, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Now Playing (M6): cover, title, controls -->
        <Border CornerRadius="18" Background="{StaticResource TileOffBrush}" Padding="8" Margin="0,8,0,0">
            <Border.Visibility>
                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                    <Binding Path="HasNowPlaying" />
                    <Binding Path="ShowTabs" />
                    <Binding Path="IsNotEditing" />
                </MultiBinding>
            </Border.Visibility>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource TabInactiveBrush}" ClipToBounds="True">
                    <Grid>
                        <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="&#xEC4F;" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                        <media:CoverImage ImageId="{Binding NowPlaying.ImageId}" ModuleId="{Binding NowPlaying.ModuleId}">
                            <media:CoverImage.Clip>
                                <RectangleGeometry Rect="0,0,40,40" RadiusX="12" RadiusY="12" />
                            </media:CoverImage.Clip>
                        </media:CoverImage>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NowPlaying.Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource SubText}" FontSize="11" Text="{Binding NowPlaying.Subtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Padding="0" Margin="0,0,4,0" Style="{StaticResource BarButton}" ToolTip="{l:T Media_Previous}"
                            Command="{Binding NowPlayingCommand}" CommandParameter="previous">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE892;" />
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Margin="0,0,4,0" Style="{StaticResource BarButton}" Background="{DynamicResource AccentBrush}" ToolTip="{l:T Media_PlayPause}"
                            Command="{Binding NowPlayingCommand}" CommandParameter="playpause">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{Binding NowPlaying.PlayPauseGlyph}" />
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Style="{StaticResource BarButton}" ToolTip="{l:T Media_Next}"
                            Command="{Binding NowPlayingCommand}" CommandParameter="next">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE893;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Notification history (bell, M6) -->
        <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="2,0,0,6">
                <TextBlock Text="{l:T Panel_Notifications}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Height="28" Padding="12,0" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                        Command="{Binding ClearHistoryCommand}" Content="{l:T History_ClearAll}" FontSize="12"
                        Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <TextBlock Style="{StaticResource SubText}" Margin="2,0,0,8" FontSize="12" Text="{l:T History_Empty}"
                       Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding NotificationHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="16" Background="{StaticResource TileOffBrush}" Padding="12,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="14" Margin="0,2,10,0" VerticalAlignment="Top"
                                           Text="{Binding Icon, Converter={StaticResource IconGlyph}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource SubText}" FontSize="11" Text="{Binding Message}" TextWrapping="Wrap"
                                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource SubText}" FontSize="10" Margin="8,2,0,0" Text="{Binding TimeText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Welcome assistant (M7): first start without settings – generic through a module's fields -->
        <StackPanel DataContext="{Binding Welcome}" Margin="0,8,0,0"
                    Visibility="{Binding DataContext.IsWelcome, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:T Welcome_Title}" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,2" />
            <TextBlock Style="{StaticResource SubText}" FontSize="11" Margin="2,0,0,8" Text="{Binding StepText}" />
            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="2,0,0,12" Text="{Binding Intro}" />

            <!-- Step 1: address(es) -->
            <ItemsControl ItemsSource="{Binding AddressFields}" Visibility="{Binding IsAddressStep, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4" />
                            <Grid>
                                <TextBox Style="{StaticResource EditTextBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource SubText}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding Placeholder}"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock Style="{StaticResource SubText}" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0" Text="{Binding Description}"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Step 2: access key -->
            <ItemsControl ItemsSource="{Binding TokenFields}" Visibility="{Binding IsTokenStep, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4" />
                            <Border Background="{StaticResource ControlBrush}" CornerRadius="10" Padding="10,7">
                                <PasswordBox Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                             FontSize="13" PasswordChar="•" PasswordChanged="OnWelcomePasswordChanged" />
                            </Border>
                            <TextBlock Style="{StaticResource SubText}" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0" Text="{Binding Description}"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Step 3: test -->
            <StackPanel Visibility="{Binding IsTestStep, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding TestLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="2,2,0,2" Text="{Binding Text}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF34C759" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Height="30" Padding="12,0" Margin="0,0,6,0" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                            Command="{Binding TestCommand}" Content="{l:T Welcome_TestAgain}" />
                    <Button Height="30" Padding="12,0" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                            Command="{Binding ContinueAnywayCommand}" Content="{l:T Welcome_ContinueAnyway}"
                            Visibility="{Binding CanContinueAnyway, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,4,0,4">
                <Button HorizontalAlignment="Left" Height="32" Padding="14,0" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                        Command="{Binding SkipCommand}" Content="{l:T Welcome_Skip}" ToolTip="{l:T Welcome_Skip_Tip}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Height="32" Padding="14,0" Margin="0,0,6,0" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                            Command="{Binding BackCommand}" Content="{l:T Common_Back}" />
                    <Button Height="32" Padding="14,0" Style="{StaticResource BarButton}" Background="{DynamicResource AccentBrush}"
                            Command="{Binding NextCommand}" Content="{Binding NextLabel}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- First start (M5b): no layout yet – choice of the modules, generic -->
        <StackPanel DataContext="{Binding Setup}" Margin="0,8,0,0"
                    Visibility="{Binding DataContext.ShowSetupSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:T Welcome_Title}" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,2"
                       Visibility="{Binding IsFirstStart, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" FontSize="12" Margin="2,0,0,10"
                       Visibility="{Binding IsFirstStart, Converter={StaticResource BoolToVisibility}}"
                       Text="{l:T Setup_Intro}" />
            <TextBlock Text="{l:T Setup_AgainTitle}" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,2"
                       Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" FontSize="12" Margin="2,0,0,10"
                       Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                       Text="{l:T Setup_AgainIntro}" />
            <TextBlock Style="{StaticResource SubText}" TextWrapping="Wrap" FontSize="11" Margin="2,0,0,10" Text="{Binding Notice}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="18" Background="{StaticResource TileOffBrush}" Padding="12,4,12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Margin="2,0,8,0" Text="{Binding Icon, Converter={StaticResource IconGlyph}}" />
                                    <TextBlock Text="{Binding Question}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="330" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Choices}" ItemsPanel="{StaticResource WrapItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ChoiceButton}" ToolTip="{Binding Detail}"
                                                    Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0"
                                                               Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                                               Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.7" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource SubText}" FontSize="11" TextWrapping="Wrap" Margin="2,2,0,0" Text="{Binding Hint}"
                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Height="32" Padding="14,0" Margin="0,0,6,0" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                        Command="{Binding EmptyCommand}" Content="{l:T Setup_StartEmpty}" ToolTip="{l:T Setup_StartEmpty_Tip}"
                        Visibility="{Binding IsFirstStart, Converter={StaticResource BoolToVisibility}}" />
                <Button Height="32" Padding="14,0" Margin="0,0,6,0" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                        Command="{Binding CancelCommand}" Content="{l:T Common_Cancel}"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                <Button Height="32" Padding="14,0" Style="{StaticResource BarButton}" Background="{DynamicResource AccentBrush}"
                        Command="{Binding ApplyCommand}" Content="{l:T Common_Apply}" />
            </StackPanel>
        </StackPanel>

        <!-- Tabs (pill tabs) -->
        <WrapPanel Margin="0,8,0,12" Visibility="{Binding ShowTabs, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,8,8" Height="32" Padding="14,0"
                                Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                    <Setter Property="Background" Value="{StaticResource TabInactiveBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHiddenHere}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                            <Setter Property="ToolTip" Value="{l:T Tab_HiddenHere}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" FontSize="13" Margin="0,0,6,0"
                                           Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                                <!-- Badge in edit mode: only this device / only at home / only away -->
                                <TextBlock Style="{StaticResource IconText}" FontSize="11" Margin="6,0,0,0" Opacity="0.8" Text="&#xE7F8;"
                                           ToolTip="{l:T Tab_DeviceOnly}">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                            <Binding Path="IsEditing" />
                                            <Binding Path="IsDeviceTab" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <TextBlock Margin="6,0,0,0" FontSize="10" Opacity="0.8" VerticalAlignment="Center" Text="{Binding VisibilityBadge}">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                            <Binding Path="IsEditing" />
                                            <Binding Path="HasVisibilityBadge" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Height="32" Width="32" Padding="0" Margin="0,0,0,8" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                    Command="{Binding Edit.AddTabCommand}" ToolTip="{l:T Edit_NewTab}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE710;" />
            </Button>
        </WrapPanel>

        <!-- Tab properties (editing) -->
        <Border CornerRadius="18" Background="{StaticResource TileOffBrush}" Padding="12,4,12,12" Margin="0,0,0,12"
                DataContext="{Binding Edit}" Visibility="{Binding ShowTabProperties, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <StackPanel>
                <TextBlock Style="{StaticResource EditLabel}" Text="{l:T Edit_Tab}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource EditTextBox}" Text="{Binding TabName, UpdateSourceTrigger=LostFocus}" KeyDown="OnTextBoxKeyDown" />
                    <Button Grid.Column="1" Width="32" Height="32" Padding="0" Margin="6,0,0,0" Style="{StaticResource BarButton}"
                            Command="{Binding MoveTabLeftCommand}" ToolTip="{l:T Common_MoveLeft}">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE76B;" />
                    </Button>
                    <Button Grid.Column="2" Width="32" Height="32" Padding="0" Margin="6,0,0,0" Style="{StaticResource BarButton}"
                            Command="{Binding MoveTabRightCommand}" ToolTip="{l:T Common_MoveRight}">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE76C;" />
                    </Button>
                </Grid>

                <TextBlock Style="{StaticResource EditLabel}" Text="{l:T Edit_Icon}" />
                <ItemsControl ItemsSource="{Binding TabIcons}" ItemsPanel="{StaticResource WrapItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChoiceButton}" Width="30" Height="30" Padding="0" Margin="0,0,4,4" ToolTip="{Binding Label}"
                                    Command="{Binding DataContext.SetTabIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Value}">
                                <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="{Binding Icon, Converter={StaticResource IconGlyph}}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource EditLabel}" Text="{l:T Edit_AppliesTo}" />
                <ItemsControl ItemsSource="{Binding ScopeOptions}" ItemsPanel="{StaticResource WrapItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChoiceButton}" Content="{Binding Label}" FontSize="12"
                                    Command="{Binding DataContext.SetScopeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource EditLabel}" Text="{l:T Edit_Visible}" />
                <ItemsControl ItemsSource="{Binding VisibilityOptions}" ItemsPanel="{StaticResource WrapItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChoiceButton}" Content="{Binding Label}" FontSize="12"
                                    Command="{Binding DataContext.SetShowWhenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="{l:T Edit_HideHere}" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"
                              IsChecked="{Binding TabHiddenHere}" Visibility="{Binding CanHideTab, Converter={StaticResource BoolToVisibility}}" Focusable="False" />
                    <Button Grid.Column="1" Height="30" Padding="12,0" Style="{StaticResource BarButton}" Command="{Binding DeleteTabCommand}"
                            Visibility="{Binding ConfirmDeleteTab, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE74D;" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T Edit_DeleteTabButton}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"
                            Visibility="{Binding ConfirmDeleteTab, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DeleteTabQuestion}" Foreground="{StaticResource AlertBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Height="30" Padding="12,0" Margin="0,0,6,0" Style="{StaticResource BarButton}" Background="{StaticResource AlertBrush}"
                            Command="{Binding DeleteTabCommand}" Content="{l:T Common_Delete}" FontSize="12" />
                    <Button Height="30" Padding="12,0" Style="{StaticResource BarButton}" Command="{Binding CancelDeleteTabCommand}" Content="{l:T Common_No}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Edit the status line (M6) -->
        <Border CornerRadius="18" Background="{StaticResource TileOffBrush}" Padding="12,4,12,12" Margin="0,0,0,12"
                DataContext="{Binding Edit}" Visibility="{Binding ShowTabProperties, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <StackPanel>
                <TextBlock Style="{StaticResource EditLabel}" Text="{l:T Edit_StatusLine}" />
                <ItemsControl ItemsSource="{Binding StatusChips}" ItemsPanel="{StaticResource WrapItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="14" Background="{StaticResource TabInactiveBrush}" Padding="8,2,2,2" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Text="{Binding Icon, Converter={StaticResource IconGlyph}}" Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                    <Button Width="22" Height="22" Padding="0" Margin="4,0,0,0" Style="{StaticResource BarButton}" ToolTip="{l:T Common_MoveLeft}"
                                            Command="{Binding DataContext.MoveStatusLeftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="9" Text="&#xE76B;" />
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Style="{StaticResource BarButton}" ToolTip="{l:T Common_MoveRight}"
                                            Command="{Binding DataContext.MoveStatusRightCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="9" Text="&#xE76C;" />
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Style="{StaticResource BarButton}" ToolTip="{l:T Common_Remove}"
                                            Command="{Binding DataContext.RemoveStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="9" Text="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <TextBlock Style="{StaticResource SubText}" FontSize="11" VerticalAlignment="Center" Text="{Binding StatusHint}" />
                    <Button HorizontalAlignment="Right" Height="28" Padding="12,0" Style="{StaticResource BarButton}" Command="{Binding StartAddStatusCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" FontSize="11" Text="&#xE710;" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T Edit_AddValue}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tile grid -->
        <ScrollViewer x:Name="GridScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding ShowTabs, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl x:Name="TileGrid" ItemsSource="{Binding SelectedTab.Tiles}"
                          Width="{Binding SelectedTab.GridWidth, FallbackValue=398}"
                          Height="{Binding SelectedTab.GridHeight, FallbackValue=0}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter Property="Panel.ZIndex" Value="10" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:TileView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Assist (M6): input field at the bottom, answers below -->
        <StackPanel Margin="0,12,0,0" DataContext="{Binding Assist}">
            <StackPanel.Visibility>
                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                    <Binding Path="IsAvailable" FallbackValue="False" />
                    <Binding Path="DataContext.ShowTabs" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                    <Binding Path="DataContext.IsNotEditing" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                </MultiBinding>
            </StackPanel.Visibility>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AssistBox" Style="{StaticResource EditTextBox}" Padding="16,6,20,6"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         PreviewMouseDown="OnAssistMouseDown" PreviewKeyDown="OnAssistKeyDown" />
                <TextBlock Style="{StaticResource IconText}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="&#xE8BD;" />
                <TextBlock Style="{StaticResource SubText}" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="{Binding Placeholder}">
                    <TextBlock.Visibility>
                        <Binding Path="Text" ElementName="AssistBox" Converter="{StaticResource EmptyTextToVisible}" />
                    </TextBlock.Visibility>
                </TextBlock>
                <Button HorizontalAlignment="Right" Width="28" Height="28" Padding="0" Margin="0,0,4,0" Style="{StaticResource BarButton}"
                        Background="{DynamicResource AccentBrush}" Command="{Binding SendCommand}" ToolTip="{l:T Assist_Send}">
                    <TextBlock Style="{StaticResource IconText}" FontSize="11" Text="&#xE724;" />
                </Button>
                <!-- M6-Fix 2: new conversation by hand -->
                <Button Grid.Column="1" Height="32" Padding="10,0" Margin="6,0,0,0" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                        Command="{Binding NewConversationCommand}" ToolTip="{l:T Assist_New_Tip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="11" Text="&#xE710;" Margin="0,0,5,0" />
                        <TextBlock Text="{l:T Assist_New}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Style="{StaticResource SubText}" Margin="4,6,0,0" FontSize="11" Text="{l:T Assist_Thinking}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource SubText}" Margin="4,6,0,0" FontSize="11" Text="{l:T Assist_NewConversation}"
                       Visibility="{Binding ShowNewConversationHint, Converter={StaticResource BoolToVisibility}}" />

            <!-- M6-Fix 2: only the last exchange; long answers get "more" after 4 lines -->
            <StackPanel Margin="4,6,0,0" DataContext="{Binding Latest}"
                        Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                <TextBlock Style="{StaticResource SubText}" FontSize="11" Text="{Binding Question}" TextWrapping="Wrap" />
                <views:ClampedText x:Name="LatestAnswer" MaxLines="4"
                                   IsExpanded="{Binding DataContext.IsAnswerExpanded, RelativeSource={RelativeSource AncestorType=StackPanel, AncestorLevel=2}}">
                    <TextBlock FontSize="12" Text="{Binding Answer}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </views:ClampedText>
                <Button HorizontalAlignment="Left" Height="22" Padding="0" Margin="0,2,0,0" Style="{StaticResource BarButton}" Background="Transparent"
                        Click="OnToggleAnswer" Visibility="{Binding IsClamped, ElementName=LatestAnswer, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{l:T Assist_More}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=LatestAnswer}" Value="True">
                                        <Setter Property="Text" Value="{l:T Assist_Less}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Older entries behind "History (n)" -->
            <Button HorizontalAlignment="Left" Height="24" Padding="4,0" Margin="0,4,0,0" Style="{StaticResource BarButton}" Background="Transparent"
                    Command="{Binding ToggleHistoryCommand}" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                <Setter Property="Text" Value="&#xE76C;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHistoryExpanded}" Value="True">
                                        <Setter Property="Text" Value="&#xE70D;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SubText}" FontSize="11" Text="{Binding HistoryLabel}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Older}" Margin="0,2,0,0"
                          Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,2,0,6" Opacity="0.75">
                            <TextBlock Style="{StaticResource SubText}" FontSize="11" Text="{Binding Question}" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Text="{Binding Answer}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Editing: add tile / properties -->
        <StackPanel DataContext="{Binding Edit}" Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Button Height="34" Margin="0,12,0,0" Style="{StaticResource BarButton}" Background="{StaticResource TabInactiveBrush}"
                    Command="{Binding StartAddCommand}" Visibility="{Binding IsAdding, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE710;" Margin="0,0,8,0" />
                    <TextBlock Text="{l:T Edit_AddTile}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource SubText}" Margin="4,8,0,0" TextWrapping="Wrap" FontSize="11"
                       Text="{l:T Edit_Help}" />

            <!-- Tile properties -->
            <Border CornerRadius="18" Background="{StaticResource TileOffBrush}" Padding="12,4,12,12" Margin="0,12,0,0"
                    Visibility="{Binding HasSelectedTile, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EditLabel}">
                        <Run Text="{l:T Edit_TileLabel}" /><Run Text=" · " /><Run Text="{Binding TileTypeName, Mode=OneWay}" />
                    </TextBlock>
                    <Grid>
                        <TextBox x:Name="TileNameBox" Style="{StaticResource EditTextBox}" Text="{Binding TileLabel, UpdateSourceTrigger=LostFocus}" KeyDown="OnTextBoxKeyDown" />
                        <TextBlock Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource SubText}"
                                   Text="{Binding TileDefaultName}">
                            <TextBlock.Visibility>
                                <Binding Path="Text" ElementName="TileNameBox" Converter="{StaticResource EmptyTextToVisible}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>

                    <TextBlock Style="{StaticResource EditLabel}" Text="{l:T Edit_Size}" />
                    <ItemsControl ItemsSource="{Binding TileSizes}" ItemsPanel="{StaticResource WrapItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChoiceButton}" Content="{Binding Label}" FontSize="12" MinWidth="44"
                                        Command="{Binding DataContext.ResizeTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Value}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource EditLabel}" Text="{l:T Edit_Icon}" />
                    <ItemsControl ItemsSource="{Binding TileIcons}" ItemsPanel="{StaticResource WrapItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChoiceButton}" Width="30" Height="30" Padding="0" Margin="0,0,4,4" ToolTip="{Binding Label}"
                                        Command="{Binding DataContext.SetTileIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Value}">
                                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="{Binding Icon, Converter={StaticResource IconGlyph}}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource EditLabel}" Text="{l:T Edit_MoveToTab}" />
                    <!-- M7: dark dropdown list instead of a button row (many tabs would not fit otherwise) -->
                    <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding MoveTargets}" Tag="{l:T Edit_ChooseTab}" Margin="0,0,0,6"
                              ItemTemplate="{StaticResource IconOptionTemplate}" SelectionChanged="OnMoveTargetChosen" />

                    <Button Height="30" Padding="12,0" Margin="0,6,0,0" HorizontalAlignment="Right" Style="{StaticResource BarButton}" Command="{Binding DeleteTileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE74D;" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T Edit_DeleteTile}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Add tile -->
            <Border CornerRadius="18" Background="{StaticResource TileOffBrush}" Padding="12,4,12,12" Margin="0,12,0,0"
                    Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource EditLabel}" Text="{Binding AddTitle}" />
                        <Button HorizontalAlignment="Right" Width="26" Height="26" Padding="0" Margin="0,4,0,0" Style="{StaticResource BarButton}"
                                Command="{Binding CancelAddCommand}" ToolTip="{l:T Common_Close}">
                            <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE711;" />
                        </Button>
                    </Grid>

                    <!-- Step 1: search -->
                    <StackPanel Visibility="{Binding HasPicked, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBox x:Name="SearchBox" Style="{StaticResource EditTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource SubText}" Margin="4,6,0,0" Text="{Binding SearchHint}"
                                   Visibility="{Binding SearchHint, Converter={StaticResource NullToCollapsed}}" />
                        <ScrollViewer MaxHeight="230" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BarButton}" Margin="0,0,0,4" Padding="10,6" HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid Width="330">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="{Binding Entity.Icon, Converter={StaticResource IconGlyph}}" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Entity.Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource SubText}" FontSize="10" Text="{Binding Detail}" />
                                                    <TextBlock Style="{StaticResource SubText}" FontSize="10" Opacity="0.7" Text="{Binding Entity.Id}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Step 2: type + slots -->
                    <StackPanel Visibility="{Binding HasPicked, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="2,2,0,0" Text="{Binding Picked.Entity.Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource EditLabel}" Text="{l:T Edit_TileType}" />
                        <ItemsControl ItemsSource="{Binding TypeOptions}" ItemsPanel="{StaticResource WrapItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChoiceButton}" ContentTemplate="{StaticResource IconOptionTemplate}" Content="{Binding}"
                                            Command="{Binding DataContext.SelectTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EditLabel}" Text="{Binding Label}" />
                                        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ItemsControl ItemsSource="{Binding Candidates}" ItemsPanel="{StaticResource WrapItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ChoiceButton}" FontSize="11"
                                                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding Label}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Height="30" Padding="12,0" Margin="0,0,6,0" Style="{StaticResource BarButton}" Command="{Binding BackToSearchCommand}" Content="{l:T Common_Back}" FontSize="12" />
                            <Button Height="30" Padding="12,0" Style="{StaticResource BarButton}" Background="{DynamicResource AccentBrush}"
                                    Command="{Binding ConfirmAddCommand}" Content="{l:T Common_Add}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </StackPanel>
</UserControl>
