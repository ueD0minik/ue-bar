<!-- Publish with ReadyToRun (M5a): precompiled code → less JIT at cold start.
     Call: dotnet publish src/UeBar.App -p:PublishProfile=Release
     Result: src/UeBar.App/bin/Release/publish/ueBar.exe (needs the installed .NET 10 runtime).
     Installer and portable single exe: app/build/publish.ps1 (M7) → app/dist/. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>bin\Release\publish\</PublishDir>
  </PropertyGroup>
</Project>
