<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plugin "screenshot" (P2-5): capture an area, a window or a screen through the core's picker, then pin,
       copy, save or recognize text. References only UeBar.Sdk; text recognition through the WinRT projection
       of the target framework (Windows.Media.Ocr, offline). -->
  <Import Project="..\..\..\src\UeBar.Sdk\build\UeBar.Sdk.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>UeBar.Modules.Screenshot</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Private=false: the SDK always comes from the app, never from the plugin folder -->
    <ProjectReference Include="..\..\..\src\UeBar.Sdk\UeBar.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UeBar.Modules.Screenshot.Tests" />
  </ItemGroup>
  <Import Project="..\..\..\src\UeBar.Sdk\build\UeBar.Sdk.targets" />
</Project>
